<?xml version="1.0"?>
<Container version="2">
  <Name>container-updater</Name>
  <Repository>local/container-updater:0.7.0</Repository>
  <Registry>https://github.com/jmengit/container-updater/pkgs/container/container-updater</Registry>
  <Network>bridge</Network>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/jmengit/container-updater/issues</Support>
  <Project>https://github.com/jmengit/container-updater</Project>
  <Overview>Single-machine container updater using that machine's WUD API for update discovery and exactly one native target: local Unraid/dockerMan or one Portainer endpoint.</Overview>
  <Category>Tools: Status:</Category>
  <WebUI>http://[IP]:[PORT:8080]/</WebUI>
  <Icon>https://raw.githubusercontent.com/walkxcode/dashboard-icons/main/png/docker.png</Icon>
  <ExtraParams>--cap-drop=ALL --security-opt=no-new-privileges --tmpfs /tmp:rw,noexec,nosuid,size=32m</ExtraParams>
  <PostArgs/>
  <CPUset/>
  <DateInstalled/>
  <Requires>Direct /var/run/docker.sock access is equivalent to host-root authority. Keep the UI LAN-only. Never expose it through a public reverse proxy.</Requires>
  <Config Name="Web UI" Target="8080" Default="8090" Mode="tcp" Description="LAN UI port" Type="Port" Display="always" Required="true" Mask="false">8090</Config>
  <Config Name="Appdata" Target="/data" Default="/mnt/user/appdata/container-updater" Mode="rw" Description="SQLite database and protected Portainer configuration" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/container-updater</Config>

  <Config Name="Docker Socket" Target="/var/run/docker.sock" Default="/var/run/docker.sock" Mode="rw" Description="Docker control socket; grants host-root-equivalent authority" Type="Path" Display="always" Required="true" Mask="false">/var/run/docker.sock</Config>
  <Config Name="dockerMan Templates" Target="/boot/config/plugins/dockerMan/templates-user" Default="/boot/config/plugins/dockerMan/templates-user" Mode="rw" Description="Authoritative native Unraid container templates" Type="Path" Display="always" Required="true" Mask="false">/boot/config/plugins/dockerMan/templates-user</Config>
  <Config Name="Update Backups" Target="/backups" Default="/mnt/user/backups/container-updater" Mode="rw" Description="Template, inspect and rollback audit bundles" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/backups/container-updater</Config>
  <Config Name="Mode" Target="APP_MODE" Default="approval_driven" Description="Approval-driven execution with per-candidate confirmation" Type="Variable" Display="always" Required="true" Mask="false">approval_driven</Config>
  <Config Name="Execution Confirmation" Target="EXECUTION_CONFIRMATION" Default="I_UNDERSTAND_CONTAINER_UPDATES_MUTATE_UNRAID" Description="Exact startup safety acknowledgment" Type="Variable" Display="advanced" Required="true" Mask="false">I_UNDERSTAND_CONTAINER_UPDATES_MUTATE_UNRAID</Config>
  <Config Name="Python Path" Target="PYTHONPATH" Default="/app/src" Description="Runtime application package path" Type="Variable" Display="advanced" Required="true" Mask="false">/app/src</Config>
  <Config Name="Database URL" Target="DATABASE_URL" Default="sqlite:////data/updater.db" Description="SQLite persistence URL" Type="Variable" Display="advanced" Required="true" Mask="false">sqlite:////data/updater.db</Config>
  <Config Name="Timezone" Target="TIMEZONE" Default="America/Chicago" Description="Scheduler timezone" Type="Variable" Display="advanced" Required="true" Mask="false">America/Chicago</Config>
  <Config Name="Scan Schedule" Target="SCAN_CRON" Default="45 6 * * *" Description="Daily report import cron" Type="Variable" Display="advanced" Required="true" Mask="false">45 6 * * *</Config>
  <Config Name="Trusted Hosts" Target="TRUSTED_HOSTS" Default="192.168.86.201,localhost,127.0.0.1" Description="Allowed Host headers" Type="Variable" Display="always" Required="true" Mask="false">192.168.86.201,localhost,127.0.0.1</Config>
  <Config Name="App Base URL" Target="APP_BASE_URL" Default="http://192.168.86.201:8090" Description="Browser base URL" Type="Variable" Display="always" Required="true" Mask="false">http://192.168.86.201:8090</Config>
  <Config Name="Admin Username" Target="ADMIN_USERNAME" Default="saturn" Description="Dashboard administrator" Type="Variable" Display="always" Required="true" Mask="false">saturn</Config>
  <Config Name="Admin Password" Target="ADMIN_PASSWORD" Default="" Description="At least 12 characters" Type="Variable" Display="always" Required="true" Mask="true"/>
  <Config Name="Session Secret" Target="SESSION_SECRET" Default="" Description="At least 32 random characters" Type="Variable" Display="advanced" Required="true" Mask="true"/>
  <Config Name="Target Type" Target="TARGET_TYPE" Default="unraid" Description="Exactly one target: unraid or portainer" Type="Variable" Display="always" Required="true" Mask="false">unraid</Config>
  <Config Name="WUD URL" Target="WUD_URL" Default="http://192.168.86.201:3030" Description="WUD REST API for this target machine" Type="Variable" Display="always" Required="true" Mask="false">http://192.168.86.201:3030</Config>
  <Config Name="WUD Username" Target="WUD_USERNAME" Default="" Description="Optional WUD Basic Auth username" Type="Variable" Display="advanced" Required="false" Mask="false"/>
  <Config Name="WUD Password" Target="WUD_PASSWORD" Default="" Description="Optional WUD Basic Auth password" Type="Variable" Display="advanced" Required="false" Mask="true"/>
  <Config Name="WUD Verify TLS" Target="WUD_VERIFY_TLS" Default="true" Description="Verify WUD TLS certificates" Type="Variable" Display="advanced" Required="true" Mask="false">true</Config>
  <Config Name="LLM Research" Target="RESEARCH_ENABLED" Default="false" Description="Optional advisory-only GitHub release and issue analysis" Type="Variable" Display="always" Required="true" Mask="false">false</Config>
  <Config Name="LLM Base URL" Target="LLM_BASE_URL" Default="" Description="OpenAI-compatible API base ending in /v1" Type="Variable" Display="always" Required="false" Mask="false"></Config>
  <Config Name="LLM API Key" Target="LLM_API_KEY" Default="" Description="OpenAI-compatible API key" Type="Variable" Display="always" Required="false" Mask="true"></Config>
  <Config Name="LLM Model" Target="LLM_MODEL" Default="" Description="Provider/model identifier" Type="Variable" Display="always" Required="false" Mask="false"></Config>
  <Config Name="GitHub Token" Target="GITHUB_TOKEN" Default="" Description="Optional token for higher GitHub API limits" Type="Variable" Display="advanced" Required="false" Mask="true"></Config>
  <Config Name="Research Verify TLS" Target="RESEARCH_VERIFY_TLS" Default="true" Description="Verify LLM TLS certificates" Type="Variable" Display="advanced" Required="true" Mask="false">true</Config>
  <Config Name="LLM CF Access ID" Target="LLM_CF_ACCESS_CLIENT_ID" Default="" Description="Optional Cloudflare Access service-token ID" Type="Variable" Display="advanced" Required="false" Mask="true"></Config>
  <Config Name="LLM CF Access Secret" Target="LLM_CF_ACCESS_CLIENT_SECRET" Default="" Description="Optional Cloudflare Access service-token secret" Type="Variable" Display="advanced" Required="false" Mask="true"></Config>
  <Config Name="Portainer URL" Target="PORTAINER_URL" Default="" Description="Required only when Target Type is portainer" Type="Variable" Display="advanced" Required="false" Mask="false"/>
  <Config Name="Portainer Token" Target="PORTAINER_TOKEN" Default="" Description="Required only when Target Type is portainer" Type="Variable" Display="advanced" Required="false" Mask="true"/>
  <Config Name="Portainer Endpoint ID" Target="PORTAINER_ENDPOINT_ID" Default="0" Description="Exactly one Portainer endpoint ID" Type="Variable" Display="advanced" Required="false" Mask="false">0</Config>
  <Config Name="Self Container Name" Target="SELF_CONTAINER_NAME" Default="container-updater" Description="Excluded from self-update" Type="Variable" Display="advanced" Required="true" Mask="false">container-updater</Config>
</Container>
