<?xml version="1.0"?>
<Container version="2">
  <Name>unraid-container-updater</Name>
  <Repository>ghcr.io/jmengit/unraid-container-updater:0.1.0</Repository>
  <Registry>https://github.com/jmengit/unraid-container-updater/pkgs/container/unraid-container-updater</Registry>
  <Network>bridge</Network>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/jmengit/unraid-container-updater/issues</Support>
  <Project>https://github.com/jmengit/unraid-container-updater</Project>
  <Overview>Authenticated, report-only Unraid container update dashboard. This release records approval intent but cannot mutate containers.</Overview>
  <Category>Tools: Status:</Category>
  <WebUI>http://[IP]:[PORT:8080]/</WebUI>
  <ExtraParams>--read-only --cap-drop=ALL --security-opt=no-new-privileges --tmpfs /tmp:rw,noexec,nosuid,size=16m</ExtraParams>
  <PostArgs/>
  <CPUset/>
  <DateInstalled/>
  <DonateText/>
  <DonateLink/>
  <Requires>No Docker socket. Mount existing Hermes updater state read-only only if legacy report importing is desired.</Requires>
  <Config Name="Web UI" Target="8080" Default="8080" Mode="tcp" Description="LAN UI port" Type="Port" Display="always" Required="true" Mask="false">8080</Config>
  <Config Name="Appdata" Target="/data" Default="/mnt/user/appdata/unraid-container-updater" Mode="rw" Description="SQLite database" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/unraid-container-updater</Config>
  <Config Name="Legacy Report State" Target="/legacy-state" Default="" Mode="ro" Description="Optional existing report state directory" Type="Path" Display="always" Required="false" Mask="false"/>
  <Config Name="Mode" Target="APP_MODE" Default="report_only" Description="Must remain report_only in v0.1" Type="Variable" Display="always" Required="true" Mask="false">report_only</Config>
  <Config Name="Database URL" Target="DATABASE_URL" Default="sqlite:////data/updater.db" Description="SQLite URL" Type="Variable" Display="advanced" Required="true" Mask="false">sqlite:////data/updater.db</Config>
  <Config Name="Legacy State Dir" Target="LEGACY_STATE_DIR" Default="/legacy-state" Description="Mounted report state" Type="Variable" Display="advanced" Required="false" Mask="false">/legacy-state</Config>
  <Config Name="Trusted Hosts" Target="TRUSTED_HOSTS" Default="[IP],localhost,127.0.0.1" Description="HTTP Host allowlist" Type="Variable" Display="always" Required="true" Mask="false">[IP],localhost,127.0.0.1</Config>
  <Config Name="Admin Username" Target="ADMIN_USERNAME" Default="admin" Description="Local administrator" Type="Variable" Display="always" Required="true" Mask="false">admin</Config>
  <Config Name="Admin Password" Target="ADMIN_PASSWORD" Default="" Description="Use at least 12 random characters" Type="Variable" Display="always" Required="true" Mask="true"/>
  <Config Name="Session Secret" Target="SESSION_SECRET" Default="" Description="Use at least 32 random characters" Type="Variable" Display="always" Required="true" Mask="true"/>
  <Config Name="Timezone" Target="TIMEZONE" Default="America/Chicago" Description="IANA timezone" Type="Variable" Display="advanced" Required="true" Mask="false">America/Chicago</Config>
  <Config Name="Scan Cron" Target="SCAN_CRON" Default="45 6 * * *" Description="Five-field report import schedule" Type="Variable" Display="advanced" Required="true" Mask="false">45 6 * * *</Config>
</Container>