# Safe default. Production may use approval_driven only with exact confirmation.
APP_MODE=report_only
DATABASE_URL=sqlite:////data/updater.db
TIMEZONE=America/Chicago
SCAN_CRON=45 6 * * *
APP_BASE_URL=http://localhost:8080
TRUSTED_HOSTS=localhost,127.0.0.1
ADMIN_USERNAME=admin
ADMIN_PASSWORD_FILE=/run/secrets/admin_password
SESSION_SECRET_FILE=/run/secrets/session_secret
TARGET_TYPE=unraid
WUD_URL=http://whats-up-docker:3000
WUD_USERNAME=
WUD_PASSWORD_FILE=/run/secrets/wud_password
WUD_VERIFY_TLS=true
DISCORD_WEBHOOK_FILE=
LOG_LEVEL=INFO
DOCKER_SOCKET=/var/run/docker.sock
DOCKER_TEMPLATE_DIR=/boot/config/plugins/dockerMan/templates-user
DOCKER_BACKUP_ROOT=/backups
SELF_CONTAINER_NAME=container-updater
EXECUTION_CONFIRMATION=
